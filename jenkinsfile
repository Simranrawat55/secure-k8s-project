pipeline {
    agent any

    stages {

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t secure-k8s-app:latest .'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl apply -f k8s/ -n secure-app'
                bat 'kubectl apply -f security/ -n secure-app'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl rollout status deployment/secure-k8s-app -n secure-app'
            }
        }
    }
}