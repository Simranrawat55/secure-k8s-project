pipeline {
    agent any

    stages {

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t secure-k8s-app:latest ./app'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl config current-context'
                bat 'kubectl config view --minify'
                bat 'kubectl cluster-info'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl rollout status deployment/secure-k8s-app -n secure-app'
            }
        }
    }

    post {
        success {
            emailext(
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """Build completed successfully.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Jenkins URL: ${env.BUILD_URL}
""",
                to: "simranrawat34912@gmail.com"
            )
        }

        failure {
            emailext(
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """Build failed.

Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Jenkins URL: ${env.BUILD_URL}

Please check the Jenkins Console Output.
""",
                to: "simranrawat34912@gmail.com"
            )
        }
        always {
            echo "email notification step completed."
        }
    }
